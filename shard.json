{
  "name": "brok-obsidian",
  "version": "0.1.0",
  "description": "Mirrors a remote Obsidian vault (Local REST API plugin) into a local, read-only copy",
  "authors": ["Brokspace contributors"],
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/brokspace/brok-obsidian",
  "brok": ">=0.8.0, <1.0.0",
  "entrypoint": "bin/brok-obsidian",
  "runtime": "native",
  "permissions": {
    "filesystem": { "read": [".brokspace"], "write": [".brokspace/shards-data/brok-obsidian"] },
    "network": true,
    "env": ["OBSIDIAN_API_KEY"]
  },
  "subscribes_to": ["obsidian:sync"],
  "publishes_to": ["obsidian:synced"],
  "build": {
    "command": ["cargo", "build", "--release"],
    "artifact": "target/release/brok-obsidian"
  }
}
